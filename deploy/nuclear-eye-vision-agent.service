[Unit]
Description=Nuclear Eye — Vision Agent (synthetic → real camera via SNAPSHOT_URL)
Documentation=https://github.com/marchange7/nuclear-eye
After=network.target nuclear-eye-alarm-grader.service
Wants=nuclear-eye-alarm-grader.service

[Service]
Type=simple
User=crew
Group=crew
WorkingDirectory=/data/git/nuclear-eye
EnvironmentFile=-/home/crew/.config/nuclear-eye/env
Environment=RUST_LOG=info
Environment=HOUSE_SECURITY_CONFIG=/data/git/nuclear-eye/config/security.toml
Environment=NUCLEAR_WRAPPER_URL=http://127.0.0.1:9091
Environment=WRAPPER_REQUIRED=1
# Real-feed mode (cabled cameras .88/.85 via the camera-adapter on 127.0.0.1:8093).
# The adapter returns a JSON envelope with a data:image/jpeg;base64 `url`;
# vision_agent decodes it, then captions via FastVLM /describe on :8091.
#   CAMERA_SNAPSHOT_URL : .../api/snapshot/ssc-cabled-ch1 (.88) or .../ssc-cabled-ch2 (.85)
#   FASTVLM_URL         : http://127.0.0.1:8091 (the :8092 service has no /describe)
#   FASTVLM_API_TOKEN   : required — /describe is auth-gated (set in EnvironmentFile, not here)
#   VISION_ALLOW_SYNTHETIC=false : refuse to emit mock events
# Defaults below also live in config/security.toml [vision]; env wins.
Environment=CAMERA_SNAPSHOT_URL=http://127.0.0.1:8093/api/snapshot/ssc-cabled-ch1
Environment=FASTVLM_URL=http://127.0.0.1:8091
Environment=VISION_ALLOW_SYNTHETIC=false
ExecStart=/data/git/nuclear-eye/target/release/vision_agent
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
